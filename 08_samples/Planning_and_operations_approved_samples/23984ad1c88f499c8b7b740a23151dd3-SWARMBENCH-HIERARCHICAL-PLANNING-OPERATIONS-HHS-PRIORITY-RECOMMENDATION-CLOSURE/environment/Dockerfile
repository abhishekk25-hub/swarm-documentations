FROM python:3.12.11-slim-bookworm

COPY input_artifacts/ /input_artifacts/
# source-window-sha256=ca0146ecd0a0db114ab75474dfacc2b7b5d221e15a95c4e07ac328f879e2690c
RUN python -c "import base64; open('/usr/local/bin/source-window','wb').write(base64.b64decode(''))" \
    && chmod 0555 /usr/local/bin/source-window \
    && mkdir -p /workspace /logs/agent
WORKDIR /workspace
