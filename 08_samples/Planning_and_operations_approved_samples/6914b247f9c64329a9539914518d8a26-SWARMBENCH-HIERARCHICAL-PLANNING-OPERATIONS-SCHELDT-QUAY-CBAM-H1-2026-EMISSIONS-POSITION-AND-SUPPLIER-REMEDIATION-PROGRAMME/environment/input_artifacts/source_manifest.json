{
 "package": "Scheldt Quay CBAM position, first half of 2026",
 "compiled": "2026-08-31",
 "layers": [
  {
   "layer": "published",
   "description": "reference/commission_default_values.csv and reference/commission_annex_iv_values.csv are an extract of the default values the European Commission adopted for the CBAM definitive period, taken on 2026-08-31 from the workbook DVs as adopted_v20260204.xlsx published on the Commission's CBAM definitive regime page, which reproduces Annexes I and IV to Implementing Regulation (EU) 2025/2621 as corrected by Implementing Regulation (EU) 2026/1740. The extract carries every country of origin and every commodity code that appears in this portfolio, reshaped from one sheet per country into long form and otherwise exactly as released, including the rows the Commission publishes with no value and the N/A entries it prints for indirect emissions in the aluminium, hydrogen and iron and steel sectors.",
   "retrieved_from": "https://taxation-customs.ec.europa.eu/carbon-border-adjustment-mechanism/cbam-definitive-regime_en"
  },
  {
   "layer": "restated",
   "description": "cbam_desk_reference.md is a desk restatement of Regulation (EU) 2023/956 as amended and of the Commission guidance for the definitive period. Every rule it states is cited to its published source in its own closing section.",
   "retrieved_from": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32023R0956"
  },
  {
   "layer": "authored",
   "description": "Customs declarations, operator emissions communications, verification reports, carbon price claims, proofs of origin, supplier correspondence and the entry summary export are authored for this exercise. Customs and verification filings are commercially confidential and are not published by anybody. Scheldt Quay Customs Services NV, the twelve importers, the 36 installations, their operators and their verification bodies are invented and identify no real company, installation, verification body or person. No real operator, verifier or authority is depicted as having erred.",
   "retrieved_from": "authored 2026-08-31"
  }
 ],
